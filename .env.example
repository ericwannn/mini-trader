# 复制为 .env 后按需填写（.env 勿提交版本库）

# ── 微信公众号（搜狗）— 宏观采集可选 ──
# MINITRADER_WECHAT_ENABLED=1
# MINITRADER_WECHAT_PROXY=http://127.0.0.1:7890
# MINITRADER_WECHAT_COOKIE=SUV=...; SNUV=...

# ── LLM 摘要（digest --llm / digest-llm）— OpenAI 兼容 API ──
# 通用（OpenAI / 自建兼容网关）
# MINITRADER_LLM_API_KEY=sk-...
# MINITRADER_LLM_BASE_URL=https://api.openai.com/v1
# MINITRADER_LLM_MODEL=gpt-4o-mini

# DeepSeek（推荐：与 OpenAI 相同调用方式，仅需改 base_url 与 model）
# MINITRADER_LLM_API_KEY=sk-xxxxxxxx
# MINITRADER_LLM_BASE_URL=https://api.deepseek.com
# MINITRADER_LLM_MODEL=deepseek-chat
# 也可使用官方变量名：DEEPSEEK_API_KEY=sk-xxxxxxxx

# 旧版变量名仍兼容：MACRO_LLM_API_KEY、MACRO_LLM_BASE_URL 等

# ── Web 后端（serve / minitrader-server.sh）──
# MINITRADER_SERVER_HOST=0.0.0.0
# MINITRADER_SERVER_PORT=8000
