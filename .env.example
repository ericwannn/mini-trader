# 复制为 .env 后按需填写（.env 勿提交版本库）

# 微信公众号（搜狗）— 可选
# MACRO_WECHAT_ENABLED=1
# MACRO_WECHAT_PROXY=http://127.0.0.1:7890
# MACRO_WECHAT_COOKIE=SUV=...; SNUV=...

# LLM 摘要（digest --llm / digest-llm）— 可选
# MACRO_LLM_API_KEY=sk-...
# MACRO_LLM_BASE_URL=https://api.openai.com/v1
# MACRO_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Web 后端（serve / macro-server.sh）
# MACRO_SERVER_HOST=0.0.0.0
# MACRO_SERVER_PORT=8000
